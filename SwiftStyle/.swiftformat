--min-version 0.64.0
--swift-version 6.0
# Use two spaces for indentation. Keep code inside #if at the surrounding level.
--indent 2
--ifdef no-indent
# Only the listed SwiftFormat rules change code. All other rules are disabled.
# Existing UIStressKit switch patterns fail indent. Enable it after those sources are corrected.
# --enable indent
--rules blankLineAfterSwitchCase,conditionalAssignment,elseOnSameLine,wrapArguments,wrapIfExpressionBodies,trailingSpace
# blankLineAfterSwitchCase: add separation after multiline switch cases.
# SwiftStyle checks both compact and multiline case boundaries.
--blank-line-after-switch-case multiline-only
# conditionalAssignment: let value: Int; if ready { value = 1 } else { value = 0 }
# becomes let value: Int = if ready { ... } else { ... }.
--conditional-assignment after-property
# elseOnSameLine: continue a multiline block with } else {.
# Start guard else on a new line after a multiline condition.
--else-position same-line
--guard-else next-line
# wrapArguments: put each argument, parameter, tuple element or collection element
# on its own line in a wrapped list. Put the first item on the line after the
# opening parenthesis or bracket. Expand partially wrapped lists fully.
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--allow-partial-wrapping false
# Close wrapped argument lists on a separate line. Nested closing brackets can stay together.
--closing-paren balanced
--call-site-paren balanced
--wrap-return-type never
# wrapIfExpressionBodies: use multiline bodies in assigned if expressions.
# indent aligns nested blocks. trailingSpace removes spaces at line ends.
# SwiftLint checks line length. SwiftFormat formats existing list breaks.
# SwiftStyle checks leading binary operators, arithmetic boundaries and other closing delimiters.
# Keep wrap disabled: its line breaks do not enforce the SwiftStyle operator policy.
--max-width none
--wrap-ternary before-operators
# Skip fixtures, dependencies and build output during formatting.
# Active Codex checkouts can have a parent directory named worktrees.
--exclude **/SwiftStyle/Tests/Fixtures/**,**/.build/**,**/.swiftpm/**,**/Derived/**,**/DerivedData/**,**/build/**,**/*.xcodeproj/**,**/*.xcworkspace/**,**/Evidence/**,**/perf/**
